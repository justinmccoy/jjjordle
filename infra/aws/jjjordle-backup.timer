# /etc/systemd/system/jjjordle-backup.timer
#
# Fires jjjordle-backup.service nightly at 03:30 UTC.
#
# Enable: sudo systemctl enable --now jjjordle-backup.timer
# Check:  systemctl list-timers jjjordle-backup.timer

[Unit]
Description=Nightly run of jjjordle-backup.service

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=jjjordle-backup.service

[Install]
WantedBy=timers.target
