# Copy this to .env and fill in your values.
# This file is NEVER committed to source control.

# The 5-letter answer (kept server-side — never sent to the browser)
WORDLE_ANSWER=CHILD

# The sentence shown when the game ends
WORDLE_SENTENCE=A child is on the way.

# Small label above the sentence
WORDLE_EYEBROW=The answer was

# Set to "false" to skip word-list validation
WORDLE_VALIDATE=true

# Highlight the answer word in the sentence
WORDLE_HIGHLIGHT=true

# Port the Node server listens on
PORT=3001

# Comma-separated origins allowed during local dev (ignored in prod)
ALLOWED_ORIGINS=http://localhost:5173
