# Caddyfile — jjjordle
# Replace <yourdomain> with your actual domain (e.g. jjjordle.com).
# Caddy automatically obtains and renews a Let's Encrypt certificate.

<yourdomain> {

    # Proxy API calls to the Node/Express server
    handle /api/* {
        reverse_proxy 127.0.0.1:3001
    }

    # Serve the pre-built React client as static files
    handle {
        root * /srv/wordle/client/dist
        try_files {path} /index.html
        file_server
    }

    # Cache hashed static assets for 1 year (Vite hashes filenames)
    @static {
        path *.js *.css *.png *.jpg *.ico *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}
